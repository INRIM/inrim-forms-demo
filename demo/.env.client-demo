# Frontend per il client "demo". Backend condiviso: stack avviato con
# backend/docker-compose.yml + demo/docker-compose.demo.yml --env-file demo/.env.demo
# Uso: docker compose -p ozon-demo -f app/docker-compose.client.example.yml \
#        --env-file demo/.env.client-demo up -d

# Nome container del web-client (obbligatorio nel compose 3.0).
OZON_APP_WEB_CONTAINER_NAME=demo-web
# CLIENT_NAME resta per compatibilita' con i compose < 3.0, che costruivano
# il container name come "${CLIENT_NAME}-web": stesso risultato, demo-web.
CLIENT_NAME=demo
APP_CODE=demo
BACKEND_DOCKER_NETWORK=ozon-network

# URL interno del backend: l'host deve combaciare con
# OZON_ENV_APP_CONTAINER_NAME nel .env del backend.
BACKEND_UPSTREAM=http://ozon-env-app:8000

OZON_ANGULAR_PORT=4200

BACKENDURL=http://app:7999
SITE_URL=http://localhost:4200

AUTH_LOGIN_PATH=/api/login
AUTH_LOGOUT_PATH=/api/logout
AUTH_REFRESH_PATH=/api/auth/refresh
APP_MODULE_NAME=demo

# Nessun override: si usa il default di app/docker-compose.client.example.yml
# (ghcr.io/inrim/ozon-formio, pubblica).
