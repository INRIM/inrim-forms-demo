# =============================================================================
# Template env del backend condiviso della demo (ozon-env-app + db + keycloak
# + companion service). NON e' il file usato da docker compose: run_demo.sh lo
# rende in ../service-app/backend/.env sostituendo i segnaposto:
#   __GENERATE__   generato al primo run e persistito in demo/.env.secrets
#   __PROVISION__  valorizzato da demo/provision_keycloak.sh
# demo/.env.secrets e' gitignorato: qui dentro non va mai un segreto vero.
# =============================================================================

BACKEND_DOCKER_NETWORK=ozon-network

# --- Nomi container (obbligatori: backend/docker-compose.yml li interpola
# con ${...:?}). Devono essere univoci sull'host Docker; cambiandoli vanno
# aggiornati anche MONGO_URL, SCHEDULER_RUN_BASE_URL qui sotto e
# BACKEND_UPSTREAM in .env.client-demo. Il container keycloak lo definisce
# demo/docker-compose.demo.yml.
OZON_ENV_APP_CONTAINER_NAME=demo-ozon-env-app
OZON_ENV_APP_DB_CONTAINER_NAME=demo-ozon-env-app-db
OZON_MAIL_SENDER_CONTAINER_NAME=demo-ozon-env-mail-sender
OZON_CALENDAR_SCHEDULER_CONTAINER_NAME=demo-ozon-env-calendar-scheduler
OZON_IDENTITY_MANAGER_CONTAINER_NAME=demo-ozon-env-identity-manager
KEYCLOAK_CONTAINER_NAME=demo-ozon-env-keycloak

# --- ozon-env-app (backend) ---
APP_CODE=demo
OZON_APP_NAME=ozon-env-app-demo
LOG_LEVEL=info
ASGI_HOST=0.0.0.0
ASGI_PORT=8000
AUTH_MODE=keycloak
OZON_LOCALEDIR=/app/i18n
OZON_APPLANG=it

MONGO_USER=demo
MONGO_PASS=__GENERATE__
# host = OZON_ENV_APP_DB_CONTAINER_NAME
MONGO_URL=ozon-env-app-db:27017
MONGO_DB=demo

SESSION_SECRET=__GENERATE__
COOKIE_SECURE=false

OZON_APP_PORT=7999

# URL pubblico usato per costruire il redirect_uri OAuth2 (deve combaciare
# col client Keycloak) — qui punta al web-client (nginx proxya /auth/ /login
# /logout /refresh al backend), cosi' browser e cookie restano single-origin.
EXTERNAL_BASE_URL=http://localhost:4200

# --- Keycloak (aggiunto dalla demo in demo/docker-compose.demo.yml) ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
KEYCLOAK_PORT=8082
KEYCLOAK_SERVER_URL_INTERNAL=http://keycloak:8080
KEYCLOAK_SERVER_URL_PUBLIC=http://localhost:8082
KEYCLOAK_REALM=backend
KEYCLOAK_CLIENT_ID=backend-web
KEYCLOAK_CLIENT_SECRET=__PROVISION__
OZON_TOKEN_AUDIENCE=demo
SCHEDULER_OAUTH_AUDIENCE=demo
TOKEN_AUDIENCE=demo

# --- calendar-scheduler (M2M: client_credentials verso l'app) ---
# host = OZON_ENV_APP_CONTAINER_NAME
SCHEDULER_RUN_BASE_URL=http://ozon-env-app:8000
SCHEDULER_OAUTH_TOKEN_URL=http://keycloak:8080/realms/backend/protocol/openid-connect/token
SCHEDULER_OAUTH_CLIENT_ID=calendar-scheduler
SCHEDULER_OAUTH_CLIENT_SECRET=__PROVISION__

# --- Docker Desktop con kernel >= 6.19 (VM linuxkit 7.x) ---
# mongod 8.0/8.3 rifiuta di partire ("MongoDB cannot start: Linux kernel
# versions 6.19 and newer has a known incompatibility", SERVER-121912) e il
# container db va in restart loop: il backend non trova il db e la demo si
# ferma allo step 7/8. La 8.2 ha il fix: scommenta questa riga.
# OZON_ENV_APP_DB_IMAGE=mongo:8.2

# --- Immagini: nessun override, si usano i default di
# service-app/backend/docker-compose.yml (ghcr.io/inrim/ozon-env-app/*, pubbliche).
# Per build locali valorizza qui OZON_ENV_APP_IMAGE / OZON_ENV_APP_DB_IMAGE /
# OZON_MAIL_SENDER_IMAGE / OZON_CALENDAR_SCHEDULER_IMAGE / OZON_IDENTITY_MANAGER_IMAGE.
